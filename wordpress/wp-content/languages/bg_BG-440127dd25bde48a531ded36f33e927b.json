3a\u043e\u0432\u0435\u0442\u0435."],"Close inserter":["\u0417\u0430\u0442\u0432\u0430\u0440\u044f\u043d\u0435 \u043b\u0435\u043d\u0442\u0430\u0442\u0430 \u0441 \u0431\u043b\u043e\u043a\u043e\u0432\u0435"],"Contain text cursor inside block activated":["\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0437\u0430\u0434\u044a\u0440\u0436\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0438\u044f \u043a\u0443\u0440\u0441\u043e\u0440 \u0432 \u0431\u043b\u043e\u043a\u0430"],"Contain text cursor inside block deactivated":["\u0418\u0437\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0437\u0430\u0434\u044a\u0440\u0436\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0438\u044f \u043a\u0443\u0440\u0441\u043e\u0440 \u0432 \u0431\u043b\u043e\u043a\u0430"],"Welcome to block Widgets":["\u0414\u043e\u0431\u0440\u0435 \u0434\u043e\u0448\u043b\u0438 \u0432 \u0431\u043b\u043e\u043a\u0430 \u0414\u0436\u0430\u0434\u0436\u0438"],"Your theme provides different \u201cblock\u201d areas for you to add and edit content.\u00a0Try adding a search bar, social icons, or other types of blocks here and see how they\u2019ll look on your site.":["\u0422\u0435\u043c\u0430\u0442\u0430 \u0432\u0438 \u0438\u043c\u0430 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u0438 \u0437\u043e\u043d\u0438 \u0437\u0430 \u201e\u0431\u043b\u043e\u043a\u043e\u0432\u0435\u201c \u0437\u0430 \u0434\u043e\u0431\u0430\u0432\u044f\u043d\u0435 \u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0430\u043d\u0435 \u043d\u0430 \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435. \u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u043f\u043e\u043b\u0435 \u0437\u0430 \u0442\u044a\u0440\u0441\u0435\u043d\u0435, \u0438\u043a\u043e\u043d\u0438 \u0437\u0430 \u0441\u043e\u0446\u0438\u0430\u043b\u043d\u0438\u0442\u0435 \u043c\u0440\u0435\u0436\u0438, \u0438\u043b\u0438 \u043a\u0430\u043a\u0432\u0438\u0442\u043e \u0434\u0440\u0443\u0433\u0438 \u0431\u043b\u043e\u043a\u043e\u0432\u0435 \u0432\u0438 \u0434\u043e\u043f\u0430\u0434\u043d\u0430\u0442 \u0442\u0443\u043a, \u0438 \u0432\u0438\u0436\u0442\u0435 \u043a\u0430\u043a \u0449\u0435 \u0438\u0437\u0433\u043b\u0435\u0436\u0434\u0430\u0442 \u043d\u0430 \u0441\u0430\u0439\u0442\u0430 \u0432\u0438."],"You can now add any block to your site\u2019s widget areas. Don\u2019t worry, all of your favorite widgets still work flawlessly.":["\u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u043a\u0430\u043a\u0432\u0438 \u0434\u0430 \u0441\u0430 \u0431\u043b\u043e\u043a\u043e\u0432\u0435 \u0432 \u0437\u043e\u043d\u0438\u0442\u0435 \u0437\u0430 \u0434\u0436\u0430\u0434\u0436\u0438. \u0418 \u043d\u0435 \u0441\u0435 \u043f\u0440\u0438\u0442\u0435\u0441\u043d\u044f\u0432\u0430\u0439\u0442\u0435 - \u0432\u0441\u0435 \u043e\u0449\u0435 \u0432\u0441\u0438\u0447\u043a\u0438\u0442\u0435 \u0432\u0438 \u043b\u044e\u0431\u0438\u043c\u0438 \u0434\u0436\u0430\u0434\u0436\u0438 \u0441\u0438 \u0440\u0430\u0431\u043e\u0442\u044f\u0442 \u0431\u0435\u0437\u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043d\u043e."],"Want to stick with the old widgets?":["\u0418\u0441\u043a\u0430\u0442\u0435 \u0434\u0430 \u0441\u0435 \u0437\u0430\u0434\u044a\u0440\u0436\u0438\u0442\u0435 \u0441\u044a\u0441 \u0441\u0442\u0430\u0440\u0438\u0442\u0435 \u0434\u0436\u0430\u0434\u0436\u0438?"],"https:\/\/wordpress.org\/plugins\/classic-widgets\/":["https:\/\/wordpress.org\/plugins\/classic-widgets\/"],"Get the Classic Widgets plugin.":["\u0414\u043e\u0431\u0430\u0432\u0435\u0442\u0435 \u0441\u0438 \u0440\u0430\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0435\u0442\u043e Classic Widgets."],"New to the block editor?":["\u0411\u043b\u043e\u043a\u043e\u0432\u0438\u044f\u0442 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0435 \u043d\u0435\u0449\u043e \u043d\u043e\u0432\u043e \u0437\u0430 \u0432\u0430\u0441?"],"https:\/\/wordpress.org\/documentation\/article\/block-based-widgets-editor\/":["https:\/\/wordpress.org\/documentation\/article\/block-based-widgets-editor\/"],"Insert a link to a post or page.":["\u0412\u043c\u044a\u043a\u0432\u0430\u043d\u0435 \u043d\u0430 \u0432\u0440\u044a\u0437\u043a\u0430 \u043a\u044a\u043c \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f \u0438\u043b\u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430"],"Strikethrough the selected text.":["\u0417\u0430\u0447\u0435\u0440\u0442\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044f \u0442\u0435\u043a\u0441\u0442."],"Make the selected text inline code.":["\u041d\u0430\u043f\u0440\u0430\u0432\u0435\u0442\u0435 \u0438\u0437\u0431\u0440\u0430\u043d\u0438\u044f \u0442\u0435\u043a\u0441\u0442 \u043d\u0430 \u0432\u0433\u0440\u0430\u0434\u0435\u043d \u043a\u043e\u0434."],"Convert the current heading to a paragraph.":["\u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0432\u0430\u0439\u0442\u0435 \u0442\u0435\u043a\u0443\u0449\u043e\u0442\u043e \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0432 \u043f\u0430\u0440\u0430\u0433\u0440\u0430\u0444."],"Convert the current paragraph or heading to a heading of level 1 to 6.":["\u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0432\u0430\u0439\u0442\u0435 \u0442\u0435\u043a\u0443\u0449\u0438\u044f \u043f\u0430\u0440\u0430\u0433\u0440\u0430\u0444 \u0438\u043b\u0438 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0432 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u043d\u0438\u0432\u043e \u043e\u0442 1 \u0434\u043e 6."],"https:\/\/wordpress.org\/documentation\/article\/wordpress-block-editor\/":["https:\/\/wordpress.org\/documentation\/article\/wordpress-block-editor\/"],"Add non breaking space.":["\u0414\u043e\u0431\u0430\u0432\u0438 \u043d\u0435\u0434\u0435\u043b\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u0432\u0430\u043b."],"Tools":["\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438"],"Options":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438"],"Add a block":["\u0414\u043e\u0431\u0430\u0432\u044f\u043d\u0435 \u043d\u0430 \u0431\u043b\u043e\u043a"],"Generic label for block inserter button\u0004Add block":["\u0414\u043e\u0431\u0430\u0432\u044f\u043d\u0435 \u043d\u0430 \u0431\u043b\u043e\u043a"],"Undo":["\u041e\u0442\u043c\u044f\u043d\u0430"],"Redo":["Redo"],"Help":["\u041f\u043e\u043c\u043e\u0449"],"Widgets":["\u0414\u0436\u0430\u0434\u0436\u0438"],"Customizing":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438"],"(opens in a new tab)":["(\u043e\u0442\u0432\u0430\u0440\u044f \u0441\u0435 \u0432 \u043d\u043e\u0432 \u0440\u0430\u0437\u0434\u0435\u043b)"]}},"comment":{"reference":"wp-includes\/js\/dist\/customize-widgets.js"}}